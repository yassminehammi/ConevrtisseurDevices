<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ConvertisseurDevises.MainPage">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Entry
            x:Name="montantEntry"
            Placeholder="Entrer un montant"/>

        <Picker
            x:Name="deviseSourcePicker"
            Title="Devise source"/>

        <Picker
            x:Name="deviseDestinationPicker"
            Title="Devise destination"/>

        <Button
            Text="Convertir"
            Clicked="Convertir_Clicked"/>

        <Label
            x:Name="resultatLabel"/>

    </VerticalStackLayout>

</ContentPage>